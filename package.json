{
  "name": "ats-resume-kit",
  "version": "0.1.0",
  "description": "Render a JSON Resume into an ATS-safe one-page PDF, and check keyword coverage against a job description.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ats-resume": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "resume",
    "ats",
    "json-resume",
    "pdf",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "vite web",
    "build:web": "vite build web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "lint": "biome lint ."
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubham-bodiwal/ats-resume-kit.git"
  },
  "homepage": "https://github.com/shubham-bodiwal/ats-resume-kit#readme",
  "author": "Shubham Bhodiwal (https://github.com/shubham-bodiwal)",
  "bugs": "https://github.com/shubham-bodiwal/ats-resume-kit/issues"
}
